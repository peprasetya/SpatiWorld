<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!--
  SpatiWorld's login panel: the Second Life viewer's arrangement: one bar along the top with
  the logo, the fields and the Log In button, and the grid's own welcome page filling the rest.
  Every named control FSPanelLogin looks for is here under its Firestorm name; only where they
  sit has changed. The viewer-mode picker is kept but hidden: SpatiWorld has one mode.
-->
<panel
  follows="all"
  height="768"
  layout="topleft"
  name="panel_login"
  focus_root="true"
  background_visible="true"
  bg_opaque_color="0.075 0.080 0.090 1"
  background_opaque="true"
  width="1280">
  <panel.string
    name="forgot_password_url">
    http://secondlife.com/account/request.php
  </panel.string>
  <string name="ServerComboTooltip">
    An existing grid or a grid URI
  </string>
  <web_browser
    tab_stop="false"
    trusted_content="true"
    bg_opaque_color="Black"
    border_visible="false"
    follows="all"
    left="0"
    name="login_html"
    start_url=""
    top="104"
    height="664"
    width="1280" />
  <layout_stack
    follows="left|right|top"
    height="86"
    left="0"
    name="ui_stack"
    orientation="horizontal"
    top="18"
    width="1280">
    <layout_panel
      auto_resize="true"
      height="86"
      name="ui_elastic_pad_left"
      width="10" />
    <layout_panel
      auto_resize="false"
      follows="left|top|right"
      height="86"
      layout="topleft"
      name="ui_container"
      width="1154"
      min_width="1154">
      <layout_stack
        animate="false"
        clip="false"
        follows="all"
        height="86"
        layout="topleft"
        left="0"
        name="bar_stack"
        orientation="horizontal"
        top="0"
        width="1154">
        <layout_panel
          auto_resize="false"
          height="86"
          layout="topleft"
          name="logo_panel"
          width="184">
          <icon
            height="48"
            image_name="login_fs_logo"
            layout="topleft"
            left="0"
            name="sl_logo_small"
            top="17"
            width="48" />
          <text
            follows="left|top"
            font="SansSerifHuge"
            height="30"
            layout="topleft"
            left_pad="8"
            name="logo_text"
            text_color="White"
            top="26"
            valign="center"
            width="124">
            SpatiWorld
          </text>
        </layout_panel>
        <layout_panel
          auto_resize="false"
          follows="left|top"
          height="86"
          layout="topleft"
          name="login"
          width="190">
          <combo_box
            allow_text_entry="true"
            combo_editor.commit_on_focus_lost="false"
            combo_editor.font="SansSerifMedium"
            combo_editor.prevalidator="ascii"
            follows="left|top"
            force_disable_fulltext_search="true"
            height="26"
            label="Username"
            layout="topleft"
            left="4"
            max_chars="128"
            name="username_combo"
            tool_tip="The username you chose when you registered, like bobsmith12 or Steller Sunshine"
            top="20"
            width="182">
            <combo_box.combo_editor
              bg_image_always_focused="true"
              text_pad_left="6"
              text_pad_right="6"/>
          </combo_box>
          <check_box
            control_name="FSRememberUsername"
            follows="left|top"
            height="16"
            label="Remember me"
            layout="topleft"
            left="2"
            name="remember_username_check"
            tab_stop="false"
            top_pad="6"
            width="180" />
        </layout_panel>
        <layout_panel
          auto_resize="false"
          follows="left|top"
          height="86"
          layout="topleft"
          name="delete_container"
          tab_stop="false"
          width="30">
          <button
            follows="left|top"
            height="26"
            image_pressed="TrashItem_Press"
            image_selected="TrashItem_Press"
            image_unselected="TrashItem_Off"
            label=""
            layout="topleft"
            left="0"
            name="remove_user_btn"
            tool_tip="Remove this username"
            top="20"
            width="26" />
        </layout_panel>
        <layout_panel
          auto_resize="false"
          follows="left|top"
          height="86"
          layout="topleft"
          name="password_container"
          width="190">
          <!-- The max length might be changed in FSPanelLogin.cpp for OpenSim. -->
          <line_editor
            bg_image_always_focused="true"
            commit_on_focus_lost="false"
            follows="left|top"
            font="SansSerifMedium"
            height="26"
            is_password="true"
            label="Password"
            layout="topleft"
            left="4"
            max_length_chars="16"
            name="password_edit"
            select_on_focus="true"
            text_pad_left="6"
            text_pad_right="6"
            top="20"
            width="182" />
          <check_box
            control_name="RememberPassword"
            enabled_control="FSRememberUsername"
            follows="left|top"
            height="16"
            label="Remember password"
            layout="topleft"
            left="2"
            name="remember_check"
            tab_stop="false"
            top_pad="6"
            width="160" />
          <button
            bottom_delta="0"
            follows="left|top"
            height="18"
            image_pressed="Profile_Group_Visibility_Off_Pressed"
            image_unselected="Profile_Group_Visibility_Off"
            left="166"
            name="password_show_btn"
            tab_stop="false"
            tool_tip="Show password text"
            visible="true"
            width="18" />
          <button
            bottom_delta="0"
            follows="left|top"
            height="18"
            image_pressed="Profile_Group_Visibility_On_Pressed"
            image_unselected="Profile_Group_Visibility_On"
            left="166"
            name="password_hide_btn"
            tab_stop="false"
            tool_tip="Hide password text"
            visible="false"
            width="18" />
        </layout_panel>
        <layout_panel
          auto_resize="false"
          follows="left|top"
          height="86"
          layout="topleft"
          name="start_location_panel"
          width="180">
          <combo_box
            allow_text_entry="true"
            combo_button.scale_image="true"
            combo_editor.font="SansSerifMedium"
            control_name="NextLoginLocation"
            follows="left|top"
            height="26"
            label="Start location"
            layout="topleft"
            left="4"
            max_chars="128"
            name="start_location_combo"
            top="20"
            width="172">
            <combo_box.combo_editor
              bg_image_always_focused="true"
              text_pad_left="6"
              text_pad_right="6"/>
            <combo_box.item
              label="My last location"
              name="MyLastLocation"
              value="last" />
            <combo_box.item
              label="Home"
              name="MyHome"
              value="home" />
            <combo_box.item
              label="&lt;Type region name&gt;"
              name="Typeregionname"
              value="" />
          </combo_box>
        </layout_panel>
        <layout_panel
          auto_resize="false"
          follows="left|top"
          height="86"
          layout="topleft"
          name="grid_panel"
          visible="true"
          width="190">
          <text
            follows="left|top"
            font="SansSerifSmall"
            height="16"
            layout="topleft"
            left="6"
            name="grid_login_text"
            top="2"
            valign="center"
            width="120">
            Grid
          </text>
          <combo_box
            allow_text_entry="true"
            combo_button.scale_image="true"
            combo_editor.commit_on_focus_lost="false"
            combo_editor.font="SansSerifMedium"
            combo_editor.prevalidator="ascii"
            follows="left|top"
            font="SansSerifMedium"
            force_disable_fulltext_search="true"
            height="26"
            layout="topleft"
            left="4"
            max_chars="256"
            name="server_combo"
            top="20"
            width="182" />
          <text
            follows="left|top"
            font="SansSerifSmall"
            height="16"
            layout="topleft"
            left="6"
            name="grid_builder_text"
            text_color="EmphasisColor"
            top_pad="6"
            valign="center"
            visible="false"
            width="180">
            + Add more grids
          </text>
        </layout_panel>
        <layout_panel
          auto_resize="false"
          follows="left|top"
          height="86"
          layout="topleft"
          name="mode_selection"
          visible="false"
          width="10">
          <text
            follows="left|top"
            height="16"
            layout="topleft"
            left="0"
            name="mode_selection_text"
            top="0"
            width="10">
            Mode:
          </text>
          <combo_box
            follows="left|top"
            height="20"
            layout="topleft"
            left="0"
            max_chars="128"
            name="mode_combo"
            top="20"
            width="10">
            <combo_box.item
              label="SpatiWorld"
              name="Firestorm"
              value="settings_firestorm.xml" />
          </combo_box>
        </layout_panel>
        <layout_panel
          auto_resize="false"
          follows="left|top"
          height="86"
          layout="topleft"
          name="connect_panel"
          width="190">
          <button
            follows="left|top"
            font="SansSerifLarge"
            height="30"
            image_hover_unselected="PushButton_Login_Over"
            image_pressed="PushButton_Login_Pressed"
            image_unselected="PushButton_Login"
            label="Log In"
            label_color="White"
            layout="topleft"
            left="6"
            name="connect_btn"
            top="18"
            width="100" />
          <text
            follows="left|top"
            font="SansSerifMedium"
            height="18"
            layout="topleft"
            left_pad="10"
            name="create_new_account_text"
            text_color="EmphasisColor"
            top="24"
            width="70">
            Sign up
          </text>
          <text
            follows="left|top"
            font="SansSerifSmall"
            height="16"
            layout="topleft"
            left="12"
            name="forgot_password_text"
            text_color="EmphasisColor"
            top="54"
            width="120">
            Password help
          </text>
        </layout_panel>
      </layout_stack>
    </layout_panel>
    <layout_panel
      auto_resize="true"
      height="86"
      name="ui_elastic_pad_right"
      width="10" />
  </layout_stack>
</panel>
